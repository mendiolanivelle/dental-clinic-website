# Safe development defaults. Never put real patient data or production secrets here.
NODE_ENV=development
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://dental_portal:change-me@127.0.0.1:5432/dental_portal

# Production Coolify runtime: copy the Supavisor session-mode connection from
# Supabase, use the least-privilege dental_portal_app role, and keep port 5432.
# TLS certificate and hostname verification is automatic for Supabase hosts.
# DATABASE_URL=postgresql://dental_portal_app.<project-ref>:<url-encoded-password>@<session-pooler-host>:5432/postgres
#
# One-time migration shell only; never set these in Coolify/runtime or commit
# their real values. Run `npm run migrate:supabase`, then unset both variables.
# SUPABASE_PROJECT_REF=<project-ref>
# SUPABASE_ACCESS_TOKEN=<temporary-access-token>
#
# No Supabase URL, publishable key, service-role key, or browser SDK is needed.

# Public clinic contact details compiled into the patient-facing web app.
VITE_CLINIC_PHONE_TEL=
VITE_CLINIC_PHONE_DISPLAY=

# Generate with: openssl rand -hex 32
SESSION_PEPPER=replace-with-at-least-32-random-bytes

SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
# Limit direct full-name + patient-ID login attempts per client IP.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# The demo seed refuses production by default. Do not override this with real data.
ALLOW_PRODUCTION_DEMO_SEED=false
